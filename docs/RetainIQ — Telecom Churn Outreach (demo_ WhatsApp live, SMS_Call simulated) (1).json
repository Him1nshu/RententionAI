{
  "name": "RetainIQ — Telecom Churn Outreach (demo: WhatsApp live, SMS/Call simulated)",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "telecom-retention",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "0269b500-5fdd-4bcc-9011-1416f4926636",
      "name": "Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1,
      "position": [
        -784,
        224
      ],
      "webhookId": "telecom-retention"
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ { \"status\": \"ok\", \"received\": $json.body.customers ? $json.body.customers.length : 0 } }}",
        "options": {}
      },
      "id": "46b7df58-29b0-49e3-b1c3-53008cb63a1e",
      "name": "Respond to Webhook",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [
        -560,
        400
      ]
    },
    {
      "parameters": {
        "jsCode": "// Webhook body: { channel, threshold_percent, customers: [...] }\nconst body = $input.first().json.body || $input.first().json;\nconst channel = body.channel || 'SMS';\nconst customers = Array.isArray(body.customers) ? body.customers : [];\n\nreturn customers.map((c) => {\n  // phone_number in sample data already includes the 91 country code.\n  // Strip a leading 91 so the Twilio nodes can safely prefix +91.\n  let phone = String(c.phone_number || '').replace(/\\D/g, '');\n// Ensure it has country code — if 10 digits add 91, if already has 91 keep it\nif (phone.length === 10) phone = '91' + phone;\n// Final format with +\nphone = '+' + phone;\n  return {\n    json: {\n      channel,\n      customer_id: c.customer_id,\n      phone_number: phone,\n      city: c.city || '',\n      state: c.state || '',\n      risk_score: c.risk_score,\n      risk_level: c.risk_level,\n      reasons: Array.isArray(c.reasons) ? c.reasons : [],\n      suggested_offer: c.suggested_offer || '',\n    }\n  };\n});"
      },
      "id": "271360de-7263-40bc-9286-d44682326d4b",
      "name": "Split Customers",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -560,
        224
      ],
      "notes": "Unwraps customers[], copies batch-level 'channel' onto each item, and normalizes phone_number (strips a leading 91 so +91 prefixing is correct)."
    },
    {
      "parameters": {
        "dataType": "string",
        "value1": "={{ $json.channel }}",
        "rules": {
          "rules": [
            {
              "value2": "WhatsApp"
            },
            {
              "value2": "SMS",
              "output": 1
            },
            {
              "value2": "Call",
              "output": 2
            }
          ]
        },
        "fallbackOutput": 0
      },
      "id": "d74935e1-41b1-46a0-b895-81ea864c888a",
      "name": "Switch Channel",
      "type": "n8n-nodes-base.switch",
      "typeVersion": 1,
      "position": [
        -304,
        224
      ],
      "notes": "Routes on the batch-level 'channel'. Fallback -> WhatsApp (the live channel) so a demo run never dead-ends."
    },
    {
      "parameters": {
        "from": "+14155238886",
        "to": "={{ $json.phone_number }}",
        "toWhatsapp": true,
        "message": "=Hi {{ $json.customer_id }}! 👋\n\n⚠️ Risk Level: {{ $json.risk_level }} ({{ $json.risk_score }}% churn risk)\n\n📋 Why we're reaching out:\n{{ $json.reasons.join(', ') }}\n\n🎁 Our offer for you: {{ $json.suggested_offer }}\n\nReply *YES* to accept or call *1800-XXX-XXXX*.\n— Your Telecom Team",
        "options": {}
      },
      "type": "n8n-nodes-base.twilio",
      "typeVersion": 1,
      "position": [
        0,
        0
      ],
      "id": "4c0ed5cd-9d5a-4702-ba82-1cd1709b87de",
      "name": "Send WhatsApp message(Twilio)",
      "credentials": {
        "twilioApi": {
          "id": "tSEG6JHj3ouQ7PVS",
          "name": "Twilio account"
        }
      },
      "notes": "LIVE. Twilio WhatsApp sandbox. Recipient must send the sandbox join code to +14155238886 first (valid 72h)."
    },
